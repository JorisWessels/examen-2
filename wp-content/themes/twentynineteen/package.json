{
  "name": "twentynineteen",
  "version": "1.0.0",
  "description": "Default WP Theme",
  "bugs": {
    "url": "https://github.com/WordPress/twentynineteen/issues"
  },
  "homepage": "https://github.com/WordPress/twentynineteen#readme",
  "devDependencies": {
    "postcss": "8.5.32",
    "npm-run-all2": "9.0.4",
    "postcss-cli": "12.0.0",
    "postcss-focus-within": "10.0.1",
    "rtlcss": "4.3.0",
    "@wordpress/browserslist-config": "7.1.0",
    "chokidar-cli": "3.0.0",
    "autoprefixer": "10.6.2",
    "sass": "1.108.1"
  },
  "rtlcssConfig": {
    "options": {
      "autoRename": false,
      "autoRenameStrict": false,
      "blacklist": {},
      "clean": true,
      "greedy": false,
      "processUrls": false,
      "stringMap": []
    },
    "plugins": [],
    "map": false
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "build:style": "sass --no-source-map style.scss style.css --style=expanded && postcss -r style.css",
    "build:style-editor": "sass --no-source-map style-editor.scss style-editor.css --style=expanded && postcss -r style-editor.css",
    "build:style-editor-customizer": "sass --no-source-map style-editor-customizer.scss style-editor-customizer.css --style=expanded && postcss -r style-editor-customizer.css",
    "build:rtl": "rtlcss style.css style-rtl.css",
    "build:print": "sass --no-source-map print.scss print.css --style=expanded && postcss -r print.css",
    "build": "run-p build:style build:style-editor build:style-editor-customizer build:print && npm run build:rtl",
    "watch": "chokidar \"**/*.scss\" -c \"npm run build\" --initial"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
